  {
    "description": "Replace text in a .docx as tracked changes in one call, no refs needed: put every change in pairs. Each old must be in the document once, or nothing is written and the error lists each place: retry with all: true for every one, a range, or a longer old. Empty new deletes. Goes to NAME.edited.docx unless output or in_place; it is validated as written, so no check or dry run is needed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "description": "Replace every occurrence of each old.",
          "type": "boolean"
        },
        "author": {
          "description": "The author, if not the server's.",
          "type": "string"
        },
        "clause": {
          "description": "Look only in these clauses, such as 11.1.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "date": {
          "description": "YYYY-MM-DDTHH:MM:SS.",
          "type": "string"
        },
        "detail": {
          "description": "The whole receipt, not a summary of about 2 KB.",
          "type": "boolean"
        },
        "dry_run": {
          "description": "Write nothing. Rarely needed: a refusal writes nothing.",
          "type": "boolean"
        },
        "expect": {
          "description": "Every occurrence, only if there are exactly N.",
          "type": "integer"
        },
        "ignore_case": {
          "description": "Match whatever the case.",
          "type": "boolean"
        },
        "in_place": {
          "description": "Write back to the input: only a file the user asked to update or this task wrote.",
          "type": "boolean"
        },
        "input": {
          "description": "The .docx, or a working copy.",
          "type": "string"
        },
        "manual": {
          "description": "Strike and underline, not tracked: only if the user asks.",
          "type": "boolean"
        },
        "manual_color": {
          "description": "As manual, in red and blue.",
          "type": "boolean"
        },
        "output": {
          "description": "The .docx to write, instead of NAME.edited.docx.",
          "type": "string"
