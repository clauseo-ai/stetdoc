[
  {
    "description": "Write a working copy of a .docx. Not needed to edit: replace, comment and edit change a .docx in one call. Unpack only to edit the files with your own tools, then pack.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "description": "The .docx, or with refresh a working copy.",
          "type": "string"
        },
        "output": {
          "description": "The working copy to write, instead of NAME.stet beside the .docx.",
          "type": "string"
        },
        "refresh": {
          "description": "Render a working copy again, dropping unpacked hand edits.",
          "type": "boolean"
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "name": "unpack"
  },
  {
    "description": "Write a working copy's edits into the .docx as tracked changes, validated. On stale_target, unpack again rather than force.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "description": "The author, if not the server's.",
          "type": "string"
        },
        "date": {
          "description": "YYYY-MM-DDTHH:MM:SS.",
          "type": "string"
        },
        "detail": {
          "description": "The whole receipt, not a summary of about 2 KB.",
          "type": "boolean"
        },
        "dir": {
          "description": "The working copy.",
          "type": "string"
        },
        "done": {
          "description": "Remove the working copy once the .docx is written.",
          "type": "boolean"
        },
        "force": {
          "description": "Overwrite an output this working copy did not write.",
          "type": "boolean"
        },
        "no_track": {
          "description": "Untracked: only for a document not under review.",
          "type": "boolean"
        },
        "output": {
          "description": "The .docx to write, instead of NAME.edited.docx.",
          "type": "string"
        }
      },
      "required": [
        "dir"
      ],
      "type": "object"
    },
    "name": "pack"
  },
  {
    "description": "Read a .docx: pages of about 3000 tokens (pass after: the page's next), the outline of a long body, a range, clauses, revisions, comments, or find: a line per matching paragraph with its ref, the cheap way to locate text. Use one of outline, range, clause, revisions, comments, story; find also goes with range, story or revisions.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "description": "The next of the previous page.",
          "type": "string"
        },
        "all": {
          "description": "Everything on one page.",
          "type": "boolean"
        },
        "author": {
          "description": "With revisions or comments: only this author.",
          "type": "string"
        },
        "budget": {
          "description": "The page size in tokens; 0 is everything.",
          "type": "integer"
        },
        "clause": {
          "description": "The blocks of these clauses, such as 12.3.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "comments": {
          "description": "The comment threads.",
          "type": "boolean"
        },
        "context": {
          "description": "With find or revisions: whole blocks, with N on each side.",
          "type": "integer"
        },
        "depth": {
          "description": "With outline: the deepest level.",
          "type": "integer"
        },
        "find": {
          "description": "Paragraphs holding any of these texts, one line each with its ref.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "full": {
          "description": "With revisions: the whole changed text.",
          "type": "boolean"
        },
        "input": {
          "description": "The .docx, or a working copy.",
          "type": "string"
        },
        "kind": {
          "description": "With revisions: insert, delete, move or format.",
          "type": "string"
        },
        "mode": {
          "default": "redline",
          "description": "How tracked changes show.",
          "enum": [
            "final",
            "original",
            "redline"
          ],
          "type": "string"
        },
        "no_notes": {
          "description": "Leave out the margin notes.",
          "type": "boolean"
        },
        "open": {
          "description": "With comments: only open threads.",
          "type": "boolean"
        },
        "outline": {
          "description": "The headings only.",
          "type": "boolean"
        },
        "range": {
          "description": "The blocks from one ref to another, such as p40..p60.",
          "type": "string"
        },
        "resolved": {
          "description": "With comments: only resolved threads.",
          "type": "boolean"
        },
        "revisions": {
          "description": "The tracked changes, one line each.",
          "type": "boolean"
        },
        "story": {
          "description": "One story whole, or with find, only its matches.",
          "enum": [
            "body",
            "notes",
            "headers",
            "comments"
          ],
          "type": "string"
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "name": "view"
  },
  {
    "description": "Show a block's effective formatting and where it comes from, or the styles, numbering or sections.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "description": "The .docx, or a working copy.",
          "type": "string"
        },
        "target": {
          "description": "A ref (p42, t3, r17), or styles, numbering or sections.",
          "type": "string"
        }
      },
      "required": [
        "input",
        "target"
      ],
      "type": "object"
    },
    "name": "inspect"
  },
  {
    "description": "Change a .docx in one call: all its operations and comments together, applied all or none. A refused call changes nothing and says why, so never dry-run first. Refs (p42, t3, c3) come from view. A .docx needs no base, unpack, pack or check: it goes to NAME.edited.docx unless output or in_place says where, and it is validated as written. Op fields: skills_get name operations. For text changes or comments, replace and comment need no refs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "description": "The author, if not the server's.",
          "type": "string"
        },
        "base": {
          "description": "The base token of the view or receipt the refs come from: for a working copy, not a .docx.",
          "type": "string"
        },
        "batch": {
          "description": "The operations as block text or JSON, instead of ops.",
          "type": "string"
        },
        "date": {
          "description": "YYYY-MM-DDTHH:MM:SS.",
          "type": "string"
        },
        "detail": {
          "description": "The whole receipt, not a summary of about 2 KB.",
          "type": "boolean"
        },
        "dry_run": {
          "description": "Write nothing. Rarely needed: a refusal writes nothing.",
          "type": "boolean"
        },
        "in_place": {
          "description": "Write back to the input: only a file the user asked to update or this task wrote.",
