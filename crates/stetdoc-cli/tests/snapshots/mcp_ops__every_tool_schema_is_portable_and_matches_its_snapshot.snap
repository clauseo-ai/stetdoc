                "type": "string"
              },
              "end": {
                "type": "integer"
              },
              "find": {
                "description": "Text of the paragraph, matched once unless occurrence says which.",
                "type": "string"
              },
              "first_line": {
                "type": "string"
              },
              "font": {
                "type": "string"
              },
              "hanging": {
                "type": "string"
              },
              "highlight": {
                "type": "string"
              },
              "ids": {
                "description": "Revision numbers, as view revisions shows them after #.",
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "indent_left": {
                "type": "string"
              },
              "indent_right": {
                "type": "string"
              },
              "initials": {
                "type": "string"
              },
              "italic": {
                "type": "boolean"
              },
              "keep_lines": {
                "type": "boolean"
