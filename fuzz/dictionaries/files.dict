# Tokens for the files target, in libFuzzer's dictionary format. They are the marks of the stet format that document.md is
# written in: refs at the start of a line, the marks of insertions, deletions, comments and notes, tables and their rows.
ref_p1="p1 "
ref_p4="p4 "
ref_t1="t1 "
ref_r1="r1 "
new_line="\x0a"
insertion_open="{++"
insertion_close="++}"
deletion_open="{--"
deletion_close="--}"
substitution="~>"
comment_open="{>>"
comment_close="<<}"
highlight_open="{=="
highlight_close="==}"
id_mark="{#"
note_fn="{fn1}"
note_en="{en1}"
comment_ref="{c0}"
brace_close="}"
escape="\\"
row="| "
cell_sep=" | "
heading="# "
list_item="- "
curly_open="\xe2\x80\x9c"
curly_close="\xe2\x80\x9d"
emoji="\xf0\x9f\x98\x80"
tab="\x09"
