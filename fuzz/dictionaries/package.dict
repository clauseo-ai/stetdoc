# Tokens for the package target, in libFuzzer's dictionary format. They are the signatures and
# fields of a ZIP archive, and the names of the parts a Word document has.
sig_local="PK\x03\x04"
sig_central="PK\x01\x02"
sig_end="PK\x05\x06"
sig_zip64_end="PK\x06\x06"
sig_zip64_locator="PK\x06\x07"
sig_descriptor="PK\x07\x08"
zip64_extra="\x01\x00\x10\x00"
zip64_extra_short="\x01\x00\x08\x00"
all_ones_4="\xFF\xFF\xFF\xFF"
all_ones_2="\xFF\xFF"
method_stored="\x00\x00"
method_deflate="\x08\x00"
method_unknown="\x63\x00"
flag_encrypted="\x01\x00"
flag_descriptor="\x08\x00"
flag_utf8="\x00\x08"
ole_header="\xD0\xCF\x11\xE0\xA1\xB1\x1A\xE1"
name_content_types="[Content_Types].xml"
name_root_rels="_rels/.rels"
name_document="word/document.xml"
name_document_rels="word/_rels/document.xml.rels"
name_styles="word/styles.xml"
name_core="docProps/core.xml"
name_app="docProps/app.xml"
name_media="word/media/"
name_dotdot="../"
name_dot="./"
name_double_slash="//"
name_backslash="\\"
name_root="/"
name_drive="C:\\"
xml_declaration="<?xml version=\"1.0\"?>"
