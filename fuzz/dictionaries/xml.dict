# Tokens for the xml target, in libFuzzer's dictionary format. They are XML syntax, the
# declarations a part starts with, the byte order marks of its encodings, and the namespaces and
# names of WordprocessingML.
declaration="<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
declaration_single="<?xml version='1.0' encoding='UTF-8'?>"
declaration_11="<?xml version=\"1.1\"?>"
declaration_utf16="<?xml version=\"1.0\" encoding=\"UTF-16\"?>"
declaration_ascii="encoding=\"us-ascii\""
declaration_latin="encoding=\"windows-1252\""
doctype="<!DOCTYPE "
entity="<!ENTITY "
element_decl="<!ELEMENT "
system="SYSTEM \"file:///etc/passwd\""
cdata_open="<![CDATA["
cdata_close="]]>"
# Text that meets text after an edit removes what was between them is joined, so these are what
# the joins are made of: line breaks, and the brackets and `>` that could make `]]>`.
carriage_return="\x0d"
line_feed="\x0a"
brackets="]]"
bracket_gt="]>"
gt=">"
char_ref_cr="&#13;"
gt_ref="&gt;"
comment_open="<!--"
comment_close="-->"
pi_open="<?"
pi_close="?>"
end_tag="</"
self_close="/>"
xmlns_prefixed="xmlns:"
xmlns_default="xmlns=\""
xml_space="xml:space=\"preserve\""
mc_ignorable="mc:Ignorable=\""
amp="&amp;"
lt="&lt;"
gt="&gt;"
quot="&quot;"
apos="&apos;"
char_ref_hex="&#x"
char_ref_dec="&#"
undefined_entity="&nbsp;"
bom_utf8="\xEF\xBB\xBF"
bom_utf16le="\xFF\xFE"
bom_utf16be="\xFE\xFF"
utf16le_decl="<\x00?\x00"
utf16be_decl="\x00<\x00?"
ns_main="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
ns_relationships="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
ns_mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
ns_content_types="http://schemas.openxmlformats.org/package/2006/content-types"
ns_package_relationships="http://schemas.openxmlformats.org/package/2006/relationships"
ns_w14="http://schemas.microsoft.com/office/word/2010/wordml"
ns_xml="http://www.w3.org/XML/1998/namespace"
document="<w:document"
body="<w:body>"
paragraph="<w:p>"
run="<w:r>"
text="<w:t>"
text_preserve="<w:t xml:space=\"preserve\">"
properties="<w:rPr>"
insertion="<w:ins "
deletion="<w:del "
attribute_id="w:id=\""
attribute_author="w:author=\""
attribute_val="w:val=\""
alternate_content="<mc:AlternateContent>"
crlf="\x0D\x0A"
tab="\x09"
nul="\x00"
