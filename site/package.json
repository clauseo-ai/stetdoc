{
  "name": "stetdoc-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/docs-artifacts.ts && next build && bun scripts/strip-runtime.ts && pagefind --site out --glob \"{docs.html,docs/**/*.html}\" && bun scripts/check-site.ts && bun scripts/check-docs.ts",
    "serve": "bun scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test lib --timeout 300000"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "html-validate": "^11.17.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  }
}
